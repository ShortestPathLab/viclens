  "narrative": {
    "northStar": "A restrained school atlas",
    "overview": "The map is the working surface. Pale geography supports coloured school markers, while warm off-white panels hold compact filters and readable enrolment summaries. The interface uses restrained borders and modest shadows to distinguish controls from geography.",
    "keyCharacteristics": [
      "A dominant map with left-hand exploration controls.",
      "Category colour supported by labels and a visible legend.",
      "Compact data typography with aligned numeric comparisons."
    ],
    "rules": [
      {
        "name": "The Legend Agreement Rule",
        "body": "Markers, list dots and the legend use the same active category mapping; changing to region colours also changes the legend labels.",
        "section": "colors"
      },
      {
        "name": "The Independent Layers Rule",
        "body": "School points, enrolment zones and LGAs remain independently controllable and visually distinguishable.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep the map dominant and exploration controls compact.",
      "Do pair category colours with labels and keep the legend synchronized.",
      "Do align comparable enrolment numbers with tabular numerals.",
      "Do retain visible keyboard focus and reduced-motion support."
    ],
    "donts": [
      "Don't imply missing enrolments are zero through numeric or marker presentation.",
      "Don't use identical boundary styling for school zones and LGAs.",
      "Don't turn the compact supporting-text sizes into a universal size requirement."
    ]
  }
}
